# Copiar este archivo a .env y completar los valores reales.
# .env nunca se sube a Git (ver .gitignore); .env.example sí, como plantilla.

# Generar una clave nueva, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-random-secret-key

# En desarrollo local: DEBUG=True
# En producción: DEBUG=False (obligatorio, nunca dejar True en producción)
DEBUG=False

# Lista de hosts/dominios permitidos, separados por coma.
# En desarrollo alcanza con 127.0.0.1,localhost.
# En producción agregar el dominio o IP real donde se despliega la app.
ALLOWED_HOSTS=127.0.0.1,localhost
